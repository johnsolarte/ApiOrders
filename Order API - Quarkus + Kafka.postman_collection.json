                  "var json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('orderId', json.id); console.log('✅ orderId guardado:', json.id); }",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Status es PENDING', () => pm.expect(json.status).to.eql('PENDING'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
